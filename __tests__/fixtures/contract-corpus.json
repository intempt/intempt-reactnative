    {
      "method": "products",
      "js": {
        "fn": "products",
        "args": [
          {
            "feedId": "feed-1"
          }
        ]
      },
      "native": {
        "fn": "products",
        "args": [
          "default",
          "feed-1",
          10,
          [
            "productId",
            "title",
            "price",
            "imageUrl",
            "url"
          ],
          null
        ]
      },
      "note": "fields MUST default to the compact set. An unfielded request returns raw ML embedding vectors \u2014 443x the payload for the same 10 products, 503 bytes against 222,919. A platform defaulting this to all fields is non-conformant."
    },
