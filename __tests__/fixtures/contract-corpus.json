    {
      "method": "productOrdered",
      "js": {
        "fn": "productOrdered",
        "args": [
          [
            {
              "productId": "sku-1",
              "quantity": 2
            },
            {
              "productId": "sku-2",
              "quantity": 1
            }
          ]
        ]
      },
      "native": {
        "fn": "productOrdered",
        "args": [
          "default",
          [
            {
              "productId": "sku-1",
              "quantity": 2
            },
            {
              "productId": "sku-2",
              "quantity": 1
            }
          ]
        ]
      },
      "note": "Typed pairs. Android's List<Map<String,Any>> admits a map with neither key and fails at runtime."
    },
    {
      "method": "consent",
      "js": {
        "fn": "consent",
        "args": [
          "accept",
          1798761600,
          {
            "email": "a@b.com"
          }
        ]
      },
      "native": {
        "fn": "consent",
        "args": [
          "default",
          "accept",
          1798761600,
          "a@b.com",
          null,
          null
        ]
      },
      "note": "action is an enum value, not a free string. reject additionally opts out; accept opts in. Consent transmits even when opted out."
    },
