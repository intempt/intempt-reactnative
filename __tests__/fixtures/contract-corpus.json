{
  "$comment": [
    "Executable form of intempt-swift/docs/SDK-API-CONTRACT.md.",
    "",
    "Each entry names a contract method, the JavaScript call that invokes it,",
    "and the exact positional arguments the native module must receive. Every",
    "contract method MUST appear here \u2014 a missing entry fails the corpus test,",
    "so adding a method to the contract without a fixture is a red build.",
    "",
    "SCOPE: this file asserts the BRIDGE contract, not the wire contract. What",
    "goes over HTTP is asserted in the SDK repos against docs/CONTRACT.md,",
    "which was probed against production. A bridge fixture passing tells you",
    "the right native call was made; it does not tell you the right bytes were",
    "delivered. Both halves are required, and the delivery half is the one that",
    "caught a transport posting headers=null while producing correct payloads."
  ],
  "instanceName": "default",
  "methods": [
    {
      "method": "track",
      "js": {
        "fn": "track",
        "args": [
          "Signed up",
          {
            "plan": "pro",
            "seats": 3,
            "trial": false
          }
        ]
      },
      "native": {
        "fn": "track",
        "args": [
          "default",
          "Signed up",
          {
            "plan": "pro",
            "seats": 3,
            "trial": false
          }
        ]
      },
      "note": "seats and trial must arrive as number and boolean, not strings. Android's pre-3.0 Map<String,String> surface stringified both."
    },
    {
      "method": "track",
      "js": {
        "fn": "track",
        "args": [
          "Opened app"
        ]
      },
      "native": {
        "fn": "track",
        "args": [
          "default",
          "Opened app",
          null
        ]
      },
      "note": "Omitted data is null, not an empty object."
    },
    {
      "method": "track",
      "js": {
        "fn": "track",
        "args": [
          "Renewed",
          {
            "at": {
              "$date": "2026-08-15T10:30:00.000Z"
            }
          }
        ]
      },
      "native": {
        "fn": "track",
        "args": [
          "default",
          "Renewed",
          {
            "at": "2026-08-15T10:30:00.000Z"
          }
        ]
      },
      "note": "Date has no bridge representation. It crosses as ISO 8601 and native re-types it."
    },
    {
      "method": "track",
      "js": {
        "fn": "track",
        "args": [
          "Cleared",
          {
            "keep": null,
            "drop": {
              "$undefined": true
            }
          }
        ]
      },
      "native": {
        "fn": "track",
        "args": [
          "default",
          "Cleared",
          {
            "keep": null
          }
        ]
      },
      "note": "An explicit null clears an attribute and is forwarded. An undefined is an absent key and is dropped \u2014 forwarding it as null would clear something the caller never mentioned."
    },
    {
      "method": "identify",
      "js": {
        "fn": "identify",
        "args": [
          "user-1",
          {
            "userAttributes": {
              "email": "a@b.com"
            }
          }
        ]
      },
      "native": {
        "fn": "identify",
        "args": [
          "default",
          "user-1",
          "Identify",
          {
            "email": "a@b.com"
          },
          null
        ]
      },
      "note": "eventTitle defaults to \"Identify\"."
    },
    {
      "method": "group",
      "js": {
        "fn": "group",
        "args": [
          "acct-1",
          {
            "accountAttributes": {
              "tier": "enterprise"
            }
          }
        ]
      },
      "native": {
        "fn": "group",
        "args": [
          "default",
          "acct-1",
          "Identify",
          {
            "tier": "enterprise"
          }
        ]
      },
      "note": "accountAttributes, not userAttributes. The deprecated Obj-C SDK named this parameter userAttributes while sending an account."
    },
    {
      "method": "alias",
      "js": {
        "fn": "alias",
        "args": [
          "user-1",
          "anon-9"
        ]
      },
      "native": {
        "fn": "alias",
        "args": [
          "default",
          "user-1",
          "anon-9"
        ]
      }
    },
    {
      "method": "record",
      "js": {
        "fn": "record",
        "args": [
          "Renewed",
          {
            "userId": "user-1",
            "accountId": "acct-1",
            "data": {
              "mrr": 120
            }
          }
        ]
      },
      "native": {
        "fn": "record",
        "args": [
          "default",
          "Renewed",
          "user-1",
          "acct-1",
          {
            "mrr": 120
          },
          null,
          null
        ]
      },
      "note": "FROZEN ORDER: userId before accountId, then data, userAttributes, accountAttributes. Android ordered these the other way before 3.0. This fixture is the regression test for that."
    },
    {
      "method": "productAdd",
