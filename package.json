{
  "name": "intempt-react-native",
  "version": "0.1.0",
  "description": "Intempt SDK for React Native — event tracking, identity, consent and personalization",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src/",
    "lib/",
    "ios/",
    "android/src/",
    "android/build.gradle",
    "IntemptReactNative.podspec",
    "react-native.config.js",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "intempt",
    "react-native",
    "ios",
    "android",
    "analytics",
    "tracking",
    "personalization",
    "cdp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intempt/intempt-reactnative.git"
  },
  "author": "Intempt Technologies, Inc.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/intempt/intempt-reactnative/issues"
  },
  "homepage": "https://github.com/intempt/intempt-reactnative#readme",
  "dependencies": {},
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@react-native/babel-preset": "^0.81.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "^0.81.0",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "react-native",
    "testEnvironment": "node",
    "verbose": true,
    "setupFiles": [
      "<rootDir>/__tests__/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@react-native|react-native)/)"
    ]
  },
  "codegenConfig": {
    "name": "RNIntemptSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.intempt.reactnative"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
